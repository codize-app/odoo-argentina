<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario de pagos: información y cálculo de retenciones -->
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherited.withholding</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">50</field>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <!-- Campos técnicos utilizados por dominios y modifiers -->
                <field name="automatic" invisible="1"/>
                <field name="withholding_accumulated_payments" invisible="1"/>
                <field name="payment_method_code" invisible="1"/>

                <!-- Datos principales de la retención -->
                <group string="Retención">

                    <field name="tax_withholding_id"
                           string="Impuesto de retención"
                           options="{'no_create': True, 'no_open': True}"
                           domain="[
                               ('type_tax_use', '=', partner_type),
                               ('company_id', '=', company_id)
                           ]"
                           required="payment_method_code == 'withholding'"/>

                    <field name="withholding_number"
                           string="Nro de retención"/>

                    <field name="withholding_base_amount"
                           string="Monto base de retención"
                           required="payment_method_code == 'withholding'"/>

                </group>

                <!-- Detalle generado por la retención automática -->
                <group string="Detalle de retención"
                       invisible="not automatic">

                    <field name="withholdable_invoiced_amount"
                           string="Importe imputado sujeto a retención"/>

                    <field name="withholdable_advanced_amount"
                           string="Importe a cuenta sujeto a retención"/>

                    <field name="accumulated_amount"
                           string="Monto acumulado"
                           invisible="not withholding_accumulated_payments"/>

                    <field name="total_amount"
                           string="Monto total"/>

                    <field name="withholding_non_taxable_minimum"
                           string="Mínimo no imponible"/>

                    <field name="withholding_non_taxable_amount"
                           string="Monto no imponible"/>

                    <field name="withholdable_base_amount"
                           string="Monto base sujeto a retención"/>

                    <field name="period_withholding_amount"
                           string="Retención del período"
                           readonly="1"
                           invisible="not withholding_accumulated_payments"/>

                    <field name="previous_withholding_amount"
                           string="Retención período anterior"
                           invisible="not withholding_accumulated_payments"/>

                    <field name="computed_withholding_amount"
                           string="Retención calculada"
                           readonly="1"/>

                </group>

                <!-- Notas del pago -->
                <notebook>
                    <page string="Notas" name="withholding_notes">
                        <field name="communication"
                               placeholder="Ingrese notas relacionadas con el pago..."/>
                    </page>
                </notebook>

            </xpath>

        </field>
    </record>


    <!-- Vista de lista general de pagos -->
    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.list.inherited.withholding</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>

        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="payment_method_code"
                       column_invisible="1"/>
            </xpath>
        </field>
    </record>


    <!-- Vista de lista de pagos desde grupos de pago -->
    <record id="view_account_payment_from_group_tree" model="ir.ui.view">
        <field name="name">account.payment.group.list.inherited.withholding</field>
        <field name="model">account.payment</field>
        <field name="inherit_id"
               ref="account_payment_group.view_account_payment_from_group_tree"/>

        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="payment_method_code"
                       column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>