<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="move_form" model="ir.ui.view">
    <field name="name">account.move.form</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <!-- pay_now journal field for customer invoices -->
        <field name="invoice_date_due" position="after">
            <field name="pay_now_journal_id"
                   options="{'no_create': True}"
                   domain="[('company_id', '=', company_id), ('type', 'in', ['bank', 'cash'])]"
                   groups="account_payment_group.group_pay_now_customer_invoices"/>
        </field>

        <!-- Override register payment button to use payment group -->
        <button name="action_register_payment" position="attributes">
            <attribute name="name">action_account_invoice_payment_group</attribute>
            <attribute name="type">object</attribute>
        </button>

        <!-- Add payment groups info after payments_widget -->
        <field name="invoice_payments_widget" position="after">
            <field name="payment_group_ids" invisible="1"/>
            <button type="object" name="action_view_payment_groups"
                    class="oe_link" string="Ver Grupos de Pago"
                    invisible="not payment_group_ids"/>
        </field>
    </field>
</record>

</odoo>
